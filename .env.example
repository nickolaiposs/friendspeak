# Copy to .env for `docker compose`, or paste into Portainer's
# "Environment variables" (Advanced mode) when creating the stack.

# Published by the release workflow on every push to `prod`
FRIENDSPEAK_IMAGE=ghcr.io/nickolaiposs/friendspeak:latest
# Host port friends connect to
FRIENDSPEAK_PORT=3000

SERVER_NAME=friendspeak
# Joining takes an invite. The first start prints one that never expires in the
# container log (docker compose logs friendspeak); make more in Server settings
# → Invites in the app, or in the admin dashboard.
# Optional: server-side GIF search (https://developers.giphy.com)
GIPHY_API_KEY=
# Total space for files uploaded to channels, e.g. 500MB, 2GB, 10GB
MAX_STORAGE=2GB
# How many days the server keeps its log history (admin dashboard → Logs); 0 = memory only
LOG_RETENTION_DAYS=14
# Most disk space the log history may use, e.g. 50MB, 200MB
LOG_MAX_SIZE=50MB
# Most memory the server's container may use, e.g. 512m, 2g. Past it, Docker restarts the server
FRIENDSPEAK_MEMORY=1g
# 1 = self-signed HTTPS on the container port; 0 = plain HTTP behind a TLS reverse proxy
HTTPS=1
# 1 = behind a reverse proxy, take each person's address from the proxy (the last one in
# X-Forwarded-For), for bans, sign-in limits and the audit log. Leave empty unless the
# proxy is the only thing that can reach friendspeak's port: anyone else could claim any address.
TRUST_PROXY=
# Optional key for the admin dashboard (16+ characters).
# If empty, a key is generated and printed once in the container log on first start.
ADMIN_KEY=
# The dashboard's path. Empty = a random one (/admin-…), made on the first start and printed
# in the container log at every start. off = the plain /admin. Or your own, such as /backoffice
ADMIN_PATH=
# off = an admin key alone signs in, with no code from an authenticator app
ADMIN_MFA=on

# off = disable the penguin game entirely (otherwise it's toggled in Settings → Server)
GAME=on
GAME_WORLD=Blizzard
GAME_MAX_USERS=300
# Absolute host paths to the game asset packs (see README → Game assets)
GAME_ASSETS_PATH=/opt/friendspeak/assets-pack
GAME_EXTRA_ASSETS_PATH=/opt/friendspeak/assets-extra

# Updates: off | notify | on (on = install automatically in the maintenance window)
AUTO_UPDATE=on
# Cron format (minute hour day-of-month month day-of-week), in TZ. Default: Sunday 06:00
MAINTENANCE_CRON=0 6 * * 0
# Users see a closeable warning this long before the window (e.g. 24h, 90m, 2d)
MAINTENANCE_WARN=24h
TZ=America/New_York
# To install updates automatically, run the Watchtower sidecar too: uncomment
# both lines. Without them, new versions are only announced.
# COMPOSE_PROFILES=autoupdate
# Shared secret between friendspeak and Watchtower: openssl rand -hex 32
# WATCHTOWER_TOKEN=
# While the GitHub repo is private: a token that can read its releases (fine-grained,
# Contents: read-only) and, for pulling the image, your user + a token with read:packages
GITHUB_TOKEN=
GHCR_USER=
GHCR_TOKEN=
